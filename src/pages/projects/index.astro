---
import ProjectListItem from "../../components/projects/ProjectListItem.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjectsWithStats } from "../projects.json.ts";
import ArrowUpRight from "~icons/ph/arrow-up-right";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=3600");

const projects = await getProjectsWithStats();
const personalProjects = projects.filter((project) => project.type === "personal");
const contributions = projects.filter((project) => project.type === "contribution");
---

<BaseLayout
  title="Projects by Lucas Nørgård | Developer tools"
  description="Open-source developer tools, build tooling, and workflow experiments by Lucas Nørgård."
  keywords={["Lucas Nørgård", "luxass", "open source", "developer tools", "build tooling", "TypeScript"]}
>
  <section class="max-w-lg motion-reduce:animate-none animate-[reveal-up_520ms_ease-out_both]">
    <h1 class="text-xl font-semibold tracking-tight text-foreground sm:text-2xl">Projects</h1>
    <p class="mt-3 max-w-lg text-sm leading-6 text-foreground-muted">
      i build small tools for build systems, test suites, configuration files, and developer workflows. most started as
      a repeated problem i wanted to remove.
    </p>
  </section>

  <section class="mt-8 border-t border-card-border pt-5 motion-reduce:animate-none animate-[reveal-up_520ms_ease-out_both_80ms]">
    <div class="mb-2 flex items-baseline justify-between gap-4">
      <h2
        class="section-title"
      >
        things i built
      </h2>
      <a href="/projects.json" class="group inline-flex items-center gap-1 text-sm text-accent underline-offset-4 hover:underline">
        <span>json</span>
        <ArrowUpRight aria-hidden="true" class="link-arrow inline size-3.5 align-baseline text-foreground-muted" />
      </a>
    </div>
    <div class="divide-y divide-card-border">
      {personalProjects.map((project) => <ProjectListItem project={project} />)}
    </div>
  </section>

  {
    contributions.length > 0 && (
      <section class="mt-8 border-t border-card-border pt-5 motion-reduce:animate-none animate-[reveal-up_520ms_ease-out_both_120ms]">
        <h2 class="section-title">
          contributions
        </h2>
        <p class="mt-3 max-w-lg text-sm leading-6 text-foreground-muted">
          occasional fixes and improvements to open source projects i use.
        </p>
        <div class="mt-4 space-y-2">
          {contributions.map((project) => <ProjectListItem project={project} muted />)}
        </div>
      </section>
    )
  }
</BaseLayout>
