---
import ProjectListItem from "../../components/projects/ProjectListItem.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjectsWithDownloads } from "../projects.json.ts";

export const prerender = false;

const projects = await getProjectsWithDownloads();
---

<BaseLayout
  title="projects - luxass.dev"
  description="open source projects by lucas nørgård"
  keywords={[
    "lucas nørgård",
    "luxass",
    "projects",
    "open source",
    "typescript",
    "developer tools",
  ]}
>
  <section class="max-w-lg motion-reduce:animate-none animate-[reveal-up_520ms_ease-out_both]">
    <h1 class="text-xl font-semibold tracking-tight text-foreground sm:text-2xl">projects</h1>
    <p class="mt-3 max-w-lg text-[13px] leading-6 text-foreground-muted">
      packages and contributions, mostly around developer tooling, parsers, build systems, and typescript.
    </p>
  </section>

  <section class="mt-10 border-t border-card-border pt-6 motion-reduce:animate-none animate-[reveal-up_520ms_ease-out_both_80ms]">
    <div class="mb-4 flex items-baseline justify-between gap-4">
      <h2
        class="inline-flex items-baseline gap-2 text-base font-semibold text-foreground before:inline-block before:-translate-y-[0.05em] before:text-[11px] before:text-accent before:content-['◇'] motion-reduce:before:animate-none before:animate-[marker-turn_5s_steps(4,end)_infinite]"
      >
        open source
      </h2>
      <a href="/projects.json" class="text-[13px] text-accent underline-offset-4 hover:underline">
        json ↗
      </a>
    </div>
    <div class="space-y-4">
      {projects.map((project) => <ProjectListItem project={project} showType />)}
    </div>
  </section>
</BaseLayout>
