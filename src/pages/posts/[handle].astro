---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { handle: post.data.handle || post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;

const {
  data: { title, description, date },
} = post;

const { Content } = await render(post);

// Format dates for structured data
const publishedTime = date.toISOString();
const imageUrl = `https://image.luxass.dev/api/image/post?title=${encodeURIComponent(title)}&description=${encodeURIComponent(description)}&date=${date.toISOString()}`;

export const prerender = true;
---

<PageLayout
  title={`${title} - posts - luxass.dev`}
  description={description}
  image={imageUrl}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={publishedTime}
>
  <header class="mt-8 mb-6 border-b border-card-border pb-5">
    <h1 class="text-lg font-semibold tracking-tight text-foreground sm:text-xl">
      {title}
    </h1>
    <p class="mt-2 text-[12px] text-foreground-muted">
      {
        date
          .toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
            year: "numeric",
          })
          .toLowerCase()
      }
    </p>
  </header>
  <article
    class="typography [&_.callout-icon]:size-4 [&_.callout-icon]:shrink-0 [&_.callout-title]:mb-2 [&_.callout-title]:flex [&_.callout-title]:items-center [&_.callout-title]:gap-2 [&_.callout-title]:text-[13px] [&_.callout-title]:font-semibold [&_.callout]:my-5 [&_.callout]:border-l-[4px] [&_.callout]:py-1 [&_.callout]:pl-4 [&_.callout]:text-foreground [&_.callout>p:last-child]:mb-0 [&_.callout>p]:my-3 [&_.callout-caution]:border-l-[#d1242f] [&_.callout-caution_.callout-title]:text-[#d1242f] [&_.callout-important]:border-l-[#8250df] [&_.callout-important_.callout-title]:text-[#8250df] [&_.callout-note]:border-l-[#0969da] [&_.callout-note_.callout-title]:text-[#0969da] [&_.callout-tip]:border-l-[#1a7f37] [&_.callout-tip_.callout-title]:text-[#1a7f37] [&_.callout-warning]:border-l-[#9a6700] [&_.callout-warning_.callout-title]:text-[#9a6700] [&_pre.astro-code]:relative [&_pre.astro-code]:overflow-x-auto [&_pre.astro-code]:rounded-md [&_pre.astro-code]:border [&_pre.astro-code]:border-card-border [&_pre.astro-code]:p-3 [&_pre.astro-code]:text-[12px] [&_pre.astro-code]:leading-[1.6] [&_pre.astro-code]:[tab-size:2] [&_pre.astro-code:hover_.copy-code]:opacity-100 [&_pre.astro-code:focus-within_.copy-code]:opacity-100"
  >
    <Content />
  </article>
  <script>
    for (const pre of document.querySelectorAll("pre.astro-code")) {
      if (!(pre instanceof HTMLElement) || pre.dataset.copyReady === "true") {
        continue;
      }

      const code = pre.querySelector("code")?.textContent;
      if (code == null || code.length === 0 || navigator.clipboard == null) {
        continue;
      }

      pre.dataset.copyReady = "true";

      const button = document.createElement("button");
      button.type = "button";
      button.className =
        "copy-code absolute right-2 top-2 cursor-pointer rounded-sm border border-card-border bg-card-bg px-[0.45rem] py-[0.15rem] text-[11px] leading-[1.4] text-foreground-muted opacity-0 transition-[opacity,color,border-color] duration-150 hover:border-accent hover:text-accent data-[copied=true]:border-accent data-[copied=true]:text-accent";
      button.textContent = "copy";
      button.setAttribute("aria-label", "Copy code to clipboard");

      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(code);
        button.dataset.copied = "true";
        button.textContent = "copied";
        window.setTimeout(() => {
          delete button.dataset.copied;
          button.textContent = "copy";
        }, 1400);
      });

      pre.append(button);
    }
  </script>
</PageLayout>
