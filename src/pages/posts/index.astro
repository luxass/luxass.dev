---
import { getCollection } from "astro:content";
import PostCard from "../../components/posts/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = await getCollection("posts", ({ data }) => !data.draft).then((entries) =>
  entries.toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime()),
);

export const prerender = true;
---

<BaseLayout
  title="Writing by Lucas Nørgård | Platform engineering and tooling"
  description="Notes by Lucas Nørgård on platform engineering, CI/CD, infrastructure, and developer tooling."
  keywords={[
    "Lucas Nørgård",
    "platform engineering",
    "CI/CD",
    "infrastructure",
    "developer tooling",
  ]}
  noindex={posts.length === 0}
>
  <section class="max-w-lg motion-reduce:animate-none animate-[reveal-up_520ms_ease-out_both]">
    <h1 class="text-xl font-semibold tracking-tight text-foreground sm:text-2xl">Writing</h1>
    <p class="mt-3 text-sm leading-6 text-foreground-muted">
      notes on platform engineering, CI/CD, infrastructure, and developer tooling.
    </p>
  </section>

  <div class="mt-8 divide-y divide-card-border border-t border-card-border">
    {
      posts.length > 0 ? (
        posts.map((post) => <PostCard post={post} />)
      ) : (
        <p class="text-foreground">
          nothing published yet. you can find my work on GitHub at{" "}
          <a class="underline" href="https://github.com/luxass">
            github.com/luxass
          </a>
          .
        </p>
      )
    }
  </div>
</BaseLayout>
