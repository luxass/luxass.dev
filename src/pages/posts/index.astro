---
import { getCollection } from "astro:content";
import PostCard from "../../components/posts/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = await getCollection("posts", ({ data }) => !data.draft).then((entries) =>
  entries.toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime()),
);

export const prerender = true;
---

<BaseLayout
  title="Writing by Lucas Nørgård | Platform engineering and tooling"
  description="Notes by Lucas Nørgård on platform engineering, CI/CD, infrastructure, and developer tooling."
  keywords={[
    "Lucas Nørgård",
    "platform engineering",
    "CI/CD",
    "infrastructure",
    "developer tooling",
  ]}
  noindex={posts.length === 0}
>
  <h1 class="mb-4 text-xl font-bold text-foreground">Writing</h1>

  <p class="mb-12 text-sm leading-relaxed text-foreground">
    notes on platform engineering, CI/CD, infrastructure, and developer tooling.
  </p>

  <div class="space-y-12">
    {
      posts.length > 0 ? (
        posts.map((post) => <PostCard post={post} />)
      ) : (
        <p class="text-foreground">
          nothing published yet. you can find my work on GitHub at
          <a class="underline" href="https://github.com/luxass">
            github.com/luxass
          </a>
          .
        </p>
      )
    }
  </div>
</BaseLayout>
