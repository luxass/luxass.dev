---
import CVEntry from "../components/cv/CVEntry.astro";
import CVLink from "../components/cv/CVLink.astro";
import CVProject from "../components/cv/CVProject.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Envelope from "~icons/ph/envelope";
import GithubLogo from "~icons/ph/github-logo";
import LinkedinLogo from "~icons/ph/linkedin-logo";
import MapPin from "~icons/ph/map-pin";
import { getProjectsWithStats } from "./projects.json.ts";

export const prerender = true;

const PROJECTS_MAX = 4;

const projects = (await getProjectsWithStats()).filter((project) => project.type === "personal").slice(0, PROJECTS_MAX);
---

<BaseLayout
  title="Lucas Nørgård | Platform engineer CV"
  description="CV of Lucas Nørgård, a platform engineer working on internal tooling, CI/CD, infrastructure, and developer experience."
  keywords={[
    "Lucas Nørgård",
    "luxass",
    "platform engineer",
    "internal tooling",
    "CI/CD",
    "infrastructure",
    "developer experience",
    "Go",
    "TypeScript",
    "CV",
  ]}
  shell="cv"
>
  <header class="mb-8 border-b border-card-border pb-6 print:mb-4 print:border-b-0 print:pb-0">
    <div class="hidden print:flex print:flex-wrap print:gap-x-4 print:gap-y-1 print:text-xs print:mb-2">
      <CVLink href="mailto:lucasnrgaard@gmail.com" label="lucasnrgaard@gmail.com">
        <Envelope slot="icon" class="size-5 mr-1" />
      </CVLink>
      <CVLink href="https://linkedin.com/in/lucasnrgaard" label="@lucasnrgaard">
        <LinkedinLogo slot="icon" class="size-5 mr-1" />
      </CVLink>
      <CVLink href="https://github.com/luxass" label="@luxass">
        <GithubLogo slot="icon" class="size-5 mr-1" />
      </CVLink>
      <div class="flex items-center text-foreground-muted">
        <MapPin class="size-5 mr-1" />
        <span class="text-xs">Aarhus, Denmark</span>
      </div>
    </div>
    <h1 class="mb-2 text-xl font-semibold tracking-tight text-foreground sm:text-2xl print:text-2xl print:mb-1">
      Lucas Nørgård
    </h1>
    <div class="mb-4 flex flex-wrap gap-x-4 gap-y-1 text-foreground print:hidden">
      <CVLink href="mailto:lucasnrgaard@gmail.com" label="lucasnrgaard@gmail.com">
        <Envelope slot="icon" class="size-5 mr-1" />
      </CVLink>
      <CVLink href="https://linkedin.com/in/lucasnrgaard" label="@lucasnrgaard">
        <LinkedinLogo slot="icon" class="size-5 mr-1" />
      </CVLink>
      <CVLink href="https://github.com/luxass" label="@luxass">
        <GithubLogo slot="icon" class="size-5 mr-1" />
      </CVLink>
      <div class="flex items-center text-foreground-muted">
        <MapPin class="size-4 mr-1" />
        <span class="text-sm">Aarhus, Denmark</span>
      </div>
    </div>

    <p class="max-w-3xl text-[13px] leading-6 text-foreground-muted print:text-xs">
      Platform engineer focused on <strong>internal tooling</strong>, <strong>CI/CD</strong>, infrastructure, and <strong
        >developer experience</strong
      >. Experienced in <strong>Go</strong> and <strong>TypeScript</strong>, with a bias toward maintainable systems,
      clear ownership, and feedback loops that stay fast.
    </p>
  </header>

  <section class="mb-8 print:mb-4">
    <h2 class="mb-4 text-base font-semibold text-foreground print:text-lg print:mb-2">Experience & Education</h2>
    <div class="space-y-4 print:space-y-3">
      <CVEntry company="DevOps Engineer @ KvalitetsIT" period="Nov 2025 - Present" type="work">
        <ul
          class="text-sm print:text-xs text-foreground-muted leading-relaxed list-disc list-inside space-y-1 print:space-y-0"
        >
          <li>Working on platform infrastructure for private and public sector clients</li>
          <li>
            Developing internal components and tools for platform workflows, including a <strong>SBOM tool</strong> for
            supply chain security
          </li>
          <li>Supporting platform engineering and DevOps best practices</li>
        </ul>
      </CVEntry>

      <CVEntry company="DevOps Engineer @ Region Midtjylland" period="Sep 2024 - Nov 2025" type="work">
        <ul
          class="text-sm print:text-xs text-foreground-muted leading-relaxed list-disc list-inside space-y-1 print:space-y-0"
        >
          <li>Designed and implemented <strong>CI/CD pipelines</strong> for healthcare applications</li>
          <li>Worked with service infrastructure and deployment workflows at scale</li>
          <li>
            Supported <strong>"You Build It, You Run It" culture</strong> with focus on <strong
              >developer experience</strong
            >
          </li>
          <li>Ensured system <strong>resilience</strong> across healthcare infrastructure</li>
        </ul>
      </CVEntry>
      <CVEntry company="Software Developer @ Region Midtjylland" period="May 2023 - Sep 2024" type="work">
        <ul
          class="text-sm print:text-xs text-foreground-muted leading-relaxed list-disc list-inside space-y-1 print:space-y-0"
        >
          <li>
            Built healthcare applications using <strong>Go</strong>, <strong>TypeScript</strong>, <strong>Java</strong>, <strong
              >Kotlin</strong
            >, and <strong>Spring Boot</strong>
          </li>
          <li>
            Developed <strong>message handling systems</strong> processing <strong>300K+ weekly transactions</strong>,
            ensuring reliable data flow between X-ray and booking systems.
          </li>
          <li>
            Created <strong>patient safety solutions</strong> and <strong>SOR code</strong> management applications
          </li>
          <li>Implemented <strong>consent portals</strong> for glucose monitoring integration</li>
        </ul>
      </CVEntry>

      <CVEntry company="Web Developer Vocational Education @ Viden Djurs" period="Aug 2020 - Nov 2022" type="education">
        <p class="text-sm print:text-xs text-foreground-muted leading-relaxed">
          Full-stack web development program covering <strong>TypeScript</strong>, <strong>React</strong>, and modern
          web technologies.
        </p>
      </CVEntry>
    </div>
  </section>

  <section class="mb-8 print:mb-4">
    <h2 class="mb-4 text-base font-semibold text-foreground print:text-lg print:mb-2">Selected Projects</h2>
    <p class="mb-4 max-w-3xl text-[13px] leading-6 text-foreground-muted print:text-xs print:mb-2">
      Selected personal projects around <strong>developer workflows</strong>, <strong>build tooling</strong>, and
      automation. Most of them started as practical fixes for repeated work.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 print:grid-cols-2 print:gap-2">
      {
        projects.map((project) => (
          <CVProject title={project.title} description={project.description} href={project.href} type={project.type} />
        ))
      }
    </div>
  </section>

  <div class="pb-8 print:hidden"></div>
</BaseLayout>
