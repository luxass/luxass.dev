---
import { getCollection } from "astro:content";
import ArrowUpRight from "~icons/ph/arrow-up-right";
import PageLayout from "../layouts/PageLayout.astro";
import { sortPosts } from "../lib/utils";
import { getProjectsWithDownloads } from "./projects.json.ts";

const posts = sortPosts(await getCollection("posts", ({ data }) => !data.draft)).slice(0, 4);
const projects = (await getProjectsWithDownloads()).filter((project) => project.type === "personal").slice(0, 3);

export const prerender = false;
---

<PageLayout
  title="home - luxass.dev"
  description="personal website and blog of lucas nørgård"
  keywords={[
    "lucas nørgård",
    "luxass",
    "nørgård",
    "lucas",
    "fullstack",
    "backend",
    "frontend",
    "web developer",
    "website",
    "Web",
    "blog",
  ]}
>
  <section class="max-w-lg motion-reduce:animate-none animate-[reveal-up_520ms_ease-out_both]">
    <h1 class="text-xl font-semibold tracking-tight text-foreground sm:text-2xl">lucas nørgård</h1>
    <p class="mt-2 text-[13px] text-foreground-muted">platform engineer at kvalitetsit · aarhus, denmark</p>
    <p class="mt-4 max-w-lg text-[13px] leading-6 text-foreground">
      i maintain packages around typescript tooling, parsers, and build systems. i like boring infrastructure, small
      tools, and feedback loops that stay fast.
    </p>
  </section>

  <section class="mt-10 border-t border-card-border pt-6 motion-reduce:animate-none animate-[reveal-up_520ms_ease-out_both_80ms]">
    <div class="mb-4 flex items-baseline justify-between gap-4">
      <h2
        class="inline-flex items-baseline gap-2 text-base font-semibold text-foreground before:inline-block before:-translate-y-[0.05em] before:text-[11px] before:text-accent before:content-['◇'] motion-reduce:before:animate-none before:animate-[marker-turn_5s_steps(4,end)_infinite]"
      >
        open source
      </h2>
      <a href="/projects" class="text-[13px] text-accent underline-offset-4 hover:underline">
        all projects ↗
      </a>
    </div>
    <div class="space-y-4">
      {
        projects.map((project) => (
          <a href={project.href} target="_blank" rel="noopener noreferrer" class="group block">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-3">
            <h3 class="text-[13px] font-semibold text-foreground group-hover:text-accent">
                {project.title}
                <ArrowUpRight
                  class="ml-1 inline size-3.5 align-baseline text-foreground-muted motion-reduce:group-hover:animate-none group-hover:animate-[arrow-twitch_240ms_steps(2,end)]"
                />
              </h3>
              <span
                class:list={[
                  "shrink-0 text-[12px] text-foreground-muted before:text-accent before:content-['↯_'] motion-reduce:animate-none",
                  project.downloads != null && "download-count",
                ]}
                style={project.downloads == null ? undefined : `--download-count-end: ${project.downloads}`}
              >
                {project.downloads == null && "npm stats unavailable"}
              </span>
            </div>
            <p class="mt-1 text-[13px] leading-5 text-foreground-muted">{project.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="mt-10 border-t border-card-border pt-6 motion-reduce:animate-none animate-[reveal-up_520ms_ease-out_both_80ms]">
        <div class="mb-4 flex items-baseline justify-between gap-4">
          <h2
            class="inline-flex items-baseline gap-2 text-base font-semibold text-foreground before:inline-block before:-translate-y-[0.05em] before:text-[11px] before:text-accent before:content-['◇'] motion-reduce:before:animate-none before:animate-[marker-turn_5s_steps(4,end)_infinite]"
          >
            writing
          </h2>
          <a href="/posts" class="text-[13px] text-accent underline-offset-4 hover:underline">
            all posts ↗
          </a>
        </div>

        <div class="space-y-3">
          {posts.map(({ data, id }) => (
            <a href={`/posts/${id}`} class="group grid gap-1 sm:grid-cols-[105px_1fr] sm:items-baseline">
              <span class="text-[12px] text-foreground-muted">
                {data.date.toLocaleDateString("en-US", {
                  month: "short",
                  day: "numeric",
                  year: "numeric",
                })}
              </span>
              <span class="text-[13px] text-foreground group-hover:text-accent">{data.title}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="mt-10 border-t border-card-border pt-6 motion-reduce:animate-none animate-[reveal-up_520ms_ease-out_both_80ms]">
    <h2
      class="mb-4 inline-flex items-baseline gap-2 text-base font-semibold text-foreground before:inline-block before:-translate-y-[0.05em] before:text-[11px] before:text-accent before:content-['◇'] motion-reduce:before:animate-none before:animate-[marker-turn_5s_steps(4,end)_infinite]"
    >
      contact
    </h2>
    <div class="flex flex-wrap gap-x-4 gap-y-2 text-[13px]">
      <a href="mailto:lucasnrgaard@gmail.com" class="text-foreground underline-offset-4 hover:text-accent hover:underline">
        email
      </a>
      <a href="https://github.com/luxass" class="text-foreground underline-offset-4 hover:text-accent hover:underline">
        github
      </a>
      <a
        href="https://www.linkedin.com/in/lucasnrgaard"
        class="text-foreground underline-offset-4 hover:text-accent hover:underline"
      >
        linkedin
      </a>
      <a href="/cv" class="text-foreground underline-offset-4 hover:text-accent hover:underline">cv</a>
    </div>
  </section>
</PageLayout>
