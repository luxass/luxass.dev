---
import { Font } from "astro:assets";
import Header from "../components/ui/Header.astro";
import { getCanonicalUrl, getAlternateUrls, getDomains } from "../lib/utils";
import "../styles/globals.css";

export interface Props {
  title: string;
  description: string;
  image?: string | URL;
  keywords?: string[];
  class?: string;
}

const {
  description = "personal website and blog of lucas nørgård",
  keywords = [],
  image = new URL(`https://image.luxass.dev/api/image/text?width=1200&height=630`),
} = Astro.props;
let { title } = Astro.props;

const domains = getDomains();
const canonicalUrl = getCanonicalUrl(Astro.url.pathname);
const alternateUrls = getAlternateUrls(Astro.url.pathname);

if (title.includes("luxass.dev") && domains.isAlternate) {
  title = title.replace("luxass.dev", "luxass.com");
}

// Ensure image is a URL string
const imageUrl = typeof image === "string" ? image : image.toString();
const siteName = domains.isAlternate ? "luxass.com" : "luxass.dev";
const author = "Lucas Nørgård";
---

<!doctype html>
<html lang="en">
  <head>
    <!-- global metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />

    <!-- robots -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />

    <!-- canonical and alternate URLs -->
    <link rel="canonical" href={canonicalUrl} />
    {alternateUrls.map(({ hreflang, url }) => <link rel="alternate" hreflang={hreflang} href={url} />)}

    <!-- primary meta tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}

    <!-- open graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />

    <!-- twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <!-- links -->
    <link rel="sitemap" href={`${domains.current}/sitemap-index.xml`} />

    <Font cssVariable="--font-dm-sans" preload />
  </head>
  <body
    class="min-h-screen bg-background font-mono antialiased [--color-accent:#136f63] [--color-background:#f3f7f6] [--color-card-bg:#fff] [--color-card-border:#d2dddd] [--color-foreground-muted:#61706f] [--color-foreground:#13201f] print:bg-white"
  >
    <div
      class="mx-auto flex min-h-screen w-full max-w-[860px] flex-col px-4 py-5 text-[13px] motion-reduce:animate-none sm:px-6 print:block print:min-h-0 print:max-w-none print:p-0 animate-[page-enter_420ms_steps(7,end)_both]"
    >
      <Header />
      <main class="flex-1 print:block">
        <slot />
      </main>
    </div>
  </body>
</html>
