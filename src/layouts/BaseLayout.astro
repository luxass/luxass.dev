---
import { Font } from "astro:assets";
import Header from "../components/site/Header.astro";
import { getAlternateUrls, getCanonicalUrl, getDomains } from "../lib/domains";
// oxlint-disable-next-line import/no-unassigned-import
import "../styles/globals.css";

export interface Props {
  title: string;
  description: string;
  image?: string | URL;
  keywords?: string[];
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  noindex?: boolean;
  shell?: "default" | "cv";
}

const {
  description =
    "Lucas Nørgård is a platform engineer building internal tooling, CI/CD systems, and open-source developer tools.",
  keywords = [],
  image = new URL(`https://image.luxass.dev/api/image/text?width=1200&height=630`),
  type = "website",
  publishedTime,
  modifiedTime,
  author = "Lucas Nørgård",
  noindex = false,
  shell = "default",
} = Astro.props;
let { title } = Astro.props;

const domains = getDomains();
const canonicalUrl = getCanonicalUrl(Astro.url.pathname);
const currentUrl = `${domains.current}${Astro.url.pathname}`;
const alternateUrls = getAlternateUrls(Astro.url.pathname);
const currentSiteName = new URL(domains.current).hostname;

const imageUrl = typeof image === "string" ? image : image.toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f3f7f6" />

    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="googlebot" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <link rel="canonical" href={canonicalUrl} />
    {alternateUrls.map(({ hreflang, url }) => <link rel="alternate" hreflang={hreflang} href={url} />)}

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={currentSiteName} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />
    {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === "article" && <meta property="article:author" content={author} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <link rel="sitemap" href={`${domains.current}/sitemap-index.xml`} />

    <slot name="head" />
    <Font cssVariable="--font-dm-sans" preload />
  </head>
  <body
    class:list={[
      "min-h-screen bg-background font-mono antialiased",
      shell === "cv" && "print:bg-white",
    ]}
  >
    <div
      class:list={[
        "mx-auto flex min-h-screen w-full flex-col px-4 py-5 text-[13px] motion-reduce:animate-none sm:px-6 animate-[page-enter_420ms_steps(7,end)_both]",
        shell === "default" && "max-w-172.5",
        shell === "cv" && "max-w-215 print:block print:min-h-0 print:max-w-none print:p-0",
      ]}
    >
      <Header />
      <main class:list={["flex-1 font-sans", shell === "cv" && "print:block"]}>
        <slot />
      </main>
    </div>
  </body>
</html>
