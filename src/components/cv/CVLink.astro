---
import { stripProtocol } from "../../lib/utils";

export interface Props {
  href: string;
  label: string;
  className?: string;
}

const { href, label, className = "" } = Astro.props;
---

<a href={href} class:list={["flex items-center text-foreground-muted transition-colors hover:text-accent", className]}>
  <slot name="icon" />
  <span class="text-[13px]">
    <span class="print:hidden">{label}</span>
    <span class="hidden print:inline">{stripProtocol(href)}</span>
  </span>
</a>
