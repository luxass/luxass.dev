---
import Briefcase from "~icons/lucide/briefcase";
import GraduationCap from "~icons/lucide/graduation-cap";
import HeartHandshake from "~icons/lucide/heart-handshake";
import Rocket from "~icons/lucide/rocket";

export interface Props {
  company: string;
  period: string;
  type?: "work" | "education" | "project" | "volunteer";
}

const { company, period, type = "work" } = Astro.props;
---

<div class="mb-5 print:mb-4">
  <p
    class="mb-2 flex flex-col gap-1 text-[13px] font-semibold text-foreground sm:flex-row sm:justify-between sm:gap-3 print:text-sm print:mb-1"
  >
    <span class="flex items-center gap-2">
      {type === "work" && <Briefcase class="size-4 text-foreground-muted" />}
      {type === "education" && <GraduationCap class="size-4 text-foreground-muted" />}
      {type === "project" && <Rocket class="size-4 text-foreground-muted" />}
      {type === "volunteer" && <HeartHandshake class="size-4 text-foreground-muted" />}
      {company}
    </span>
    <span class="text-[12px] font-normal text-foreground-muted sm:text-[13px]">{period}</span>
  </p>
  <p class="text-[13px] text-foreground-muted print:text-xs">
    <slot />
  </p>
</div>
