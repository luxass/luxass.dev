---
import type { CollectionEntry } from "astro:content";
import { POST_DATE_FORMATTER } from "../../lib/utils";
import ArrowUpRight from "~icons/ph/arrow-up-right";

export interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const {
  id,
  data: { title, description, date, handle },
} = post;
---

<article>
  <a href={`/posts/${handle || id}`} class="group grid gap-1 rounded-sm py-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-x-6">
    <h2 class="flex items-baseline gap-1 text-sm font-semibold text-foreground group-hover:text-accent">
      <span class="min-w-0">{title}</span>
      <ArrowUpRight aria-hidden="true" class="link-arrow size-3.5 shrink-0 text-foreground-muted" />
    </h2>
    <p class="text-sm leading-5 text-foreground-muted sm:col-start-1 sm:row-start-2">{description}</p>
    <time datetime={date.toISOString()} class="text-xs text-foreground-muted sm:col-start-2 sm:row-start-1 sm:self-baseline">
      {POST_DATE_FORMATTER.format(date)}
    </time>
  </a>
</article>
