<span class="theme-picker relative text-foreground-muted" data-theme-picker hidden>
  <select
    aria-label="Color theme"
    data-theme-select
    class="min-h-6 cursor-pointer appearance-none rounded-sm border border-card-border bg-card-bg py-0.5 pr-7 pl-2 text-xs text-foreground-muted hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  >
    <option value="system">system</option>
    <option value="light">light</option>
    <option value="dark">dark</option>
  </select>
  <svg aria-hidden="true" class="pointer-events-none absolute top-1/2 right-2 size-3 -translate-y-1/2" viewBox="0 0 16 16" fill="none">
    <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</span>

<style>
  .theme-picker:not([hidden]) {
    display: inline-flex;
    align-items: center;
  }
</style>

<script>
  type ThemePreference = "system" | "light" | "dark";

  function parsePreference(value: string | null | undefined): ThemePreference {
    return value === "light" || value === "dark" ? value : "system";
  }

  const root = document.documentElement;
  const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");
  const select = document.querySelector<HTMLSelectElement>("[data-theme-select]");
  const picker = document.querySelector<HTMLElement>("[data-theme-picker]");
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  function updateTheme() {
    const preference = parsePreference(root.dataset.themePreference);
    const theme = preference === "system" ? (systemTheme.matches ? "dark" : "light") : preference;
    root.dataset.theme = theme;
    if (themeColor != null) {
      themeColor.content = theme === "dark" ? "#101b1a" : "#f3f7f6";
    }
    if (select != null) {
      select.value = preference;
    }
  }

  if (select != null && picker != null) {
    updateTheme();
    picker.hidden = false;
    select.addEventListener("change", () => {
      const preference = parsePreference(select.value);
      root.dataset.themePreference = preference;
      updateTheme();

      try {
        if (preference === "system") {
          localStorage.removeItem("theme");
        } else {
          localStorage.setItem("theme", preference);
        }
      } catch {
        // Keep the selection for this page when storage is unavailable.
      }
    });
  }

  systemTheme.addEventListener("change", updateTheme);
  window.addEventListener("storage", (event) => {
    if (event.key === "theme" || event.key === null) {
      root.dataset.themePreference = parsePreference(event.newValue);
      updateTheme();
    }
  });
</script>
