---
import { formatDownloads } from "../../lib/utils";
import ArrowUpRight from "~icons/ph/arrow-up-right";
import type { ProjectWithStats } from "../../pages/projects.json.ts";

export interface Props {
  project: ProjectWithStats;
  showType?: boolean;
  muted?: boolean;
}

const { project, showType = false, muted = false } = Astro.props;
const stat = project.type === "personal" ? project.stats : undefined;
const isDownloads = stat?.kind === "npm-downloads";
const statLabel = isDownloads ? "downloads / 30d" : "GitHub stars";
const statTitle = stat && [
  `${stat.value.toLocaleString("en")} ${isDownloads ? "npm downloads" : "GitHub stars"}`,
  stat.period && `Reporting period: ${stat.period.start} to ${stat.period.end}`,
  stat.fetchedAt && `Retrieved: ${stat.fetchedAt}`,
  stat.stale && "Last known count; refresh is temporarily unavailable",
].filter(Boolean).join(". ");
---

<a
  href={project.href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "project-row group grid min-w-0 gap-x-6 gap-y-1 px-3 transition-colors",
    muted ? "border-l border-card-border py-2 hover:border-accent" : "py-3 sm:grid-cols-[minmax(0,1fr)_auto]",
  ]}
>
  <h3 class="min-w-0 text-sm font-semibold text-foreground group-hover:text-accent">
    {project.featured && <span class="mr-1 text-accent" aria-label="featured project">◇</span>}
    <span class="wrap-anywhere">{project.title}</span>
    <ArrowUpRight aria-hidden="true" class="link-arrow ml-1 inline size-3.5 align-baseline text-foreground-muted" />
  </h3>
  <p class="text-sm leading-5 text-foreground-muted sm:col-span-2 sm:row-start-2">
    {project.description}
  </p>
  {
    stat ? (
      <span
        class="mt-1 inline-flex flex-wrap items-baseline gap-x-1.5 gap-y-1 text-xs text-foreground-muted sm:col-start-2 sm:row-start-1 sm:mt-0 sm:self-baseline"
        title={statTitle}
        aria-label={statTitle}
      >
        <span class="font-medium tabular-nums text-foreground">{formatDownloads(stat.value)}</span>
        <span>{statLabel}</span>
        {stat.stale && <span class="text-foreground-muted">· cached</span>}
      </span>
    ) : project.type === "personal" && project.npmPackage ? (
      <span class="mt-1 text-xs text-foreground-muted sm:col-start-2 sm:row-start-1 sm:mt-0 sm:self-baseline">
        downloads unavailable
      </span>
    ) : null
  }
  {showType && <span class="text-xs text-foreground-muted sm:col-span-2">{project.type}</span>}
</a>
