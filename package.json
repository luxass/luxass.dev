{
  "name": "luxass.dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && pnpm lint && cf build",
    "deploy:dev": "SITE_HOST=luxass.dev pnpm build --mode luxass-dev && cf deploy --prebuilt --mode luxass-dev",
    "deploy:com": "SITE_HOST=luxass.com pnpm build --mode luxass-com && cf deploy --prebuilt --mode luxass-com",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "astro-check"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "catalog:astro",
    "@astrojs/mdx": "catalog:astro",
    "@astrojs/sitemap": "catalog:astro",
    "astro": "catalog:astro"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:astro",
    "@astrojs/cloudflare": "catalog:astro",
    "@iconify-json/lucide": "catalog:icons",
    "@iconify-json/ph": "catalog:icons",
    "@tailwindcss/vite": "catalog:styling",
    "@types/node": "catalog:types",
    "cf": "catalog:dev",
    "oxfmt": "catalog:linting",
    "oxlint": "catalog:linting",
    "tailwindcss": "catalog:styling",
    "typescript": "catalog:dev",
    "unplugin-icons": "catalog:icons"
  },
  "packageManager": "pnpm@12.11.2"
}
